# Example Least-Privilege Scoped Sudoers Configuration for NetOps Guardrail Operator
#
# Production Security Recommendation:
# In development/emulated labs, development accounts often have broad sudo access
# (e.g. `(ALL) NOPASSWD: ALL`). In production deployments, sudo access should be
# strictly confined to the exact binary paths and fixed subcommands required by
# the fault injection, OpenFlow configuration, and host ping monitoring routines.
#
# DO NOT apply this file directly unless your OVS and IP binaries reside at these paths.
# Place under /etc/sudoers.d/netops-guardrail with mode 0440 after validation via visudo -cf.

Cmnd_Alias NETOPS_OVS = \
    /usr/bin/ovs-ofctl -O OpenFlow13 mod-port s[12] [123] up, \
    /usr/bin/ovs-ofctl -O OpenFlow13 mod-port s[12] [123] down, \
    /usr/bin/ovs-ofctl -O OpenFlow13 add-flow s[12] *, \
    /usr/bin/ovs-ofctl -O OpenFlow13 del-flows s[12] *, \
    /usr/bin/ovs-ofctl -O OpenFlow13 dump-flows s[12]

Cmnd_Alias NETOPS_IP = \
    /sbin/ip link set dev s1-eth3 up, \
    /sbin/ip link set dev s1-eth3 down, \
    /bin/ip link set dev s1-eth3 up, \
    /bin/ip link set dev s1-eth3 down

Cmnd_Alias NETOPS_MNEXEC = \
    /usr/bin/mnexec -a [0-9]* ping -n -c 1 -W [0-9]* [0-9.]*, \
    /usr/bin/mnexec -a [0-9]* ip -o -4 addr show

# Operator privilege rule
# Replace 'netops-operator' with the runtime service account:
# netops-operator ALL=(ALL) NOPASSWD: NETOPS_OVS, NETOPS_IP, NETOPS_MNEXEC
